generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Website {
  id        String   @id @default(cuid())
  domain    String   @unique
  da        Int      @default(0)
  dr        Int      @default(0)
  ss        String   @default("0%")
  traffic   String   @default("0")
  genre     String   @default("General")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Alert {
  id        String   @id @default(cuid())
  title     String
  condition String
  target    String
  status    String   @default("Active")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Competitor {
  id        String   @id @default(cuid())
  domain    String   @unique
  da        Int      @default(0)
  traffic   String   @default("0")
  rank      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
